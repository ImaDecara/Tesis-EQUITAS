{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.2",
    "npm": "11.21.1"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quality:duplicates": "jscpd app components lib ../back/ETL ../back/api ../back/services --min-lines 5 --min-tokens 50 --reporters console,json --output ../.quality/jscpd --no-colors",
    "quality:complexity": "jscpd app components lib ../back/ETL ../back/api ../back/services --complexity --reporters console,json --output ../.quality/jscpd --report-name complexity --no-colors",
    "test:supabase": "vitest run --config vitest.supabase.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jscpd": "^5.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.12"
  }
}
