# Variables de la app Next (EQUITAS V1). Ejemplo sin secretos: copiar a .env.local solo para
# desarrollo manual. La demo local no lo necesita: scripts/demo/equitas_demo.py start pasa estas
# variables al proceso sin escribirlas en el repositorio. Ver docs/entrega/noche-6/CUENTAS-Y-VARIABLES.md.

# Públicas: quedan incorporadas al bundle del navegador al compilar. Solo URL y clave publicable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CLAVE_PUBLICABLE

# Solo servidor (nunca con prefijo NEXT_PUBLIC_). JWT del rol equitas_review_server, firmado con el
# secreto del proyecto Supabase destino y con vencimiento. Sin él, la ficha, las decisiones y la
# auditoría (y por eso los CSV) responden "no disponible".
EQUITAS_REVIEW_SERVER_JWT=REEMPLAZAR_JWT_DE_SERVIDOR

# Opcionales. Procedencia que muestra /api/build-info (Vercel usa VERCEL_GIT_COMMIT_SHA).
# QUALITY_SOURCE_SHA=
# API interna de importación (FastAPI): solo admite loopback; no forma parte de la publicación V1.
# EQUITAS_IMPORT_API_URL=http://127.0.0.1:8000
